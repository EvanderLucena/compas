# ==============================================================================
# Compas — Environment Variables Configuration
# Suporta prefixo oficial COMPAS_* (com fallback retrocompatível para NUTRIAI_*)
# ==============================================================================

# PostgreSQL
COMPAS_DB=compas
COMPAS_USER=compas
COMPAS_PASSWORD=changeme
POSTGRES_PORT=5432
# Legado: POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD

# Backend Datasource & Server
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/compas
SPRING_DATASOURCE_USERNAME=compas
SPRING_DATASOURCE_PASSWORD=changeme
SERVER_PORT=8080

# Redis
COMPAS_REDIS_PASSWORD=compas-redis-dev-password
# Legado: REDIS_PASSWORD

# JWT & Admin Seed
COMPAS_JWT_SECRET=ci-dev-secret-minimum-32-chars-ok!
COMPAS_SEED_ADMIN_PASSWORD=admin123
COMPAS_SEED_ADMIN_EMAIL=admin@compas.app
COMPAS_SEED_ADMIN_NAME=Admin Compas
# Legado: NUTRIAI_JWT_SECRET, NUTRIAI_SEED_ADMIN_PASSWORD

# LLM (Ollama Cloud ou Local)
# Cloud: https://api.ollama.com/v1 + sua chave de API
# Local: http://localhost:11434/v1 (sem chave)
COMPAS_LLM_BASE_URL=https://api.ollama.com/v1
COMPAS_LLM_MODEL=deepseek-v4.1-flash
COMPAS_LLM_API_KEY=
# Legado: NUTRIAI_LLM_BASE_URL, NUTRIAI_LLM_MODEL, NUTRIAI_LLM_API_KEY

# Evolution Go (WhatsApp Gateway)
EVOLUTION_API_KEY=your-secure-evolution-global-api-key-here
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_WEBHOOK_URL=
COMPAS_WEBHOOK_SECRET=

# Frontend
VITE_API_URL=http://localhost:8080
VITE_PORT=5173
